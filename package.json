{
  "name": "limestone-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "QA Automation test task: Playwright + TypeScript (UI saucedemo, API jsonplaceholder), Postman, SQL",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "postman": "newman run postman/collection.json -e postman/environment.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "dotenv": "^18.0.10",
    "newman": "^6.2.3",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
