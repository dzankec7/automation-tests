# Copy to .env:  cp .env.example .env
# saucedemo publishes these demo credentials on its own login page; in a real
# project they would come from a secret store / CI secrets, never from code.
UI_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://jsonplaceholder.typicode.com
SAUCE_STANDARD_USER=standard_user
SAUCE_PROBLEM_USER=problem_user
SAUCE_PASSWORD=secret_sauce
